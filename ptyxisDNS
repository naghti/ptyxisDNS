#!/usr/bin/env python3
import os
from pathlib import Path
import sys
base = Path(__file__).resolve().parent
args = sys.argv[1:]
interface_args = []
if args == ['--help']:
    print('ptyxisDNS [--new-window] [--interface INTERFACE] [-- COMMAND ARGS...]')
    sys.exit(0)
if args[:1] == ['--new-window']:
    args = args[1:]
if args[:1] == ['--interface']:
    if len(args) < 2:
        sys.exit('Укажи интерфейс, например enp6s0')
    interface_args, args = args[:2], args[2:]
if args[:1] == ['--']:
    args = args[1:]
elif args:
    sys.exit('Использование: ptyxisDNS [--new-window] [--interface INTERFACE] [-- COMMAND ARGS...]')
os.execvp('ptyxis', ['ptyxis', '--standalone', '--title=DNS · GeoHide', '--', str(base / 'runDNS')] + interface_args + ['--'] + args)
